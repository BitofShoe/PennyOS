{
  "name": "lyra-companion-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Self-contained premium companion prototype for Lyra/OpenClaw.",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "start": "node server.js",
    "start:durable": "powershell -ExecutionPolicy Bypass -File .\\start-lyra.ps1",
    "stop": "powershell -ExecutionPolicy Bypass -File .\\stop-lyra.ps1",
    "lmstudio:prepare": "node scripts/penny-lmstudio-prepare.js",
    "preflight": "node scripts/penny-preflight.js",
    "test": "node --test test/*.test.js",
    "qa:voice-redo": "node scripts/qa-penny-voice-redo.js",
    "qa:voice-writing-compare": "node scripts/qa-penny-voice-writing-compare.js",
    "qa:voice:tiebreak": "node scripts/qa-penny-voice-redo.js --prompt-set tiebreak",
    "qa:voice:constellation": "node scripts/qa-penny-voice-redo.js --prompt-set constellation",
    "qa:memory:smoke": "node scripts/qa-penny-memory.js --smoke",
    "qa:memory": "node scripts/qa-penny-memory.js",
    "qa:memory:combined": "node scripts/qa-penny-memory.js --combined",
    "qa:memory:judged": "node scripts/qa-penny-memory.js --judged",
    "qa:memory:source-sensitive": "node scripts/qa-penny-memory.js --source-sensitive-fixture",
    "qa:memory:candidate-survival": "node scripts/qa-penny-memory.js --candidate-survival-archive-unit",
    "qa:memory:candidate-survival-fixture": "node scripts/qa-penny-memory.js --candidate-survival-fixture",
    "qa:memory:semantic": "node scripts/qa-penny-memory.js --segment semantic-archive",
    "qa:memory:chapter": "node scripts/qa-penny-memory.js --segment chapter-fallback",
    "qa:memory:contradictions": "node scripts/qa-penny-memory.js --segment contradiction-premise",
    "qa:memory:mixed": "node scripts/qa-penny-memory.js --segment mixed-drift",
    "qa:browser:smoke": "node scripts/qa-penny-browser-smoke.js",
    "qa:next-cycle": "node scripts/qa-penny-next-cycle.js",
    "eval:probes": "node scripts/eval-penny-probes.js",
    "eval:epistemic-compare": "node scripts/eval-penny-epistemic-compare.js",
    "eval:epistemic-compare:synthesis": "node scripts/eval-penny-epistemic-compare.js --primary-modes off,synthesis-only --diagnostics never",
    "eval:ledger-compare": "node scripts/eval-penny-ledger-compare.js",
    "eval:static-embedding-live-compare": "node scripts/eval-penny-static-embedding-live-compare.js",
    "eval:runtime-fit": "node scripts/eval-penny-runtime-fit.js",
    "eval:runtime-fit:context-pressure": "node scripts/eval-penny-runtime-fit.js --context-pressure-fixture",
    "eval:runtime-fit:gemma-watch": "node scripts/eval-penny-runtime-fit.js --gemma-runtime-watch",
    "eval:models": "node scripts/eval-penny-models.js",
    "ingest:conversations": "node scripts/import-penny-conversations.js",
    "preset:lmstudio": "node scripts/ensure-lmstudio-penny-preset.js",
    "bundle:review": "node scripts/build-review-bundle.js"
  },
  "optionalDependencies": {
    "@yarflam/potion-base-8m": "1.0.4"
  }
}
