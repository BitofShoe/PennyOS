{
  "name": "pennyos",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first PennyOS companion runtime for LM Studio.",
  "license": "UNLICENSED",
  "packageManager": "npm@11.12.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BitofShoe/PennyOS.git"
  },
  "homepage": "https://github.com/BitofShoe/PennyOS#readme",
  "bugs": {
    "url": "https://github.com/BitofShoe/PennyOS/issues"
  },
  "keywords": [
    "pennyos",
    "local-first",
    "companion",
    "lm-studio",
    "penny",
    "local-ai"
  ],
  "files": [
    "server.js",
    "lib/",
    "public/",
    "penny-voice/runtime/",
    "data/*.seed.json",
    "scripts/",
    "test/",
    "fixtures/",
    ".env.example",
    "docs/penny-public/",
    "docs/README.md",
    "docs/penny-for-new-developers.md",
    "docs/penny-configuration-profiles.md",
    "docs/penny-release-decisions-2026-05-18.md",
    "docs/penny-browser-manual-checklist.md",
    "docs/release-checklist.md",
    "ARCHITECTURE.md",
    "CODEBASE.md",
    "INSTALL.md",
    "PRIVACY.md",
    "SECURITY.md",
    "LICENSE",
    "start-penny.ps1",
    "stop-penny.ps1",
    "start-lyra.ps1",
    "stop-lyra.ps1"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "start": "node server.js",
    "start:durable": "powershell -ExecutionPolicy Bypass -File .\\start-penny.ps1",
    "stop": "powershell -ExecutionPolicy Bypass -File .\\stop-penny.ps1",
    "start:durable:legacy": "powershell -ExecutionPolicy Bypass -File .\\start-lyra.ps1",
    "stop:legacy": "powershell -ExecutionPolicy Bypass -File .\\stop-lyra.ps1",
    "lmstudio:prepare": "node scripts/penny-lmstudio-prepare.js",
    "preflight": "node scripts/penny-preflight.js",
    "doctor": "node scripts/penny-preflight.js",
    "test": "node --test test/*.test.js",
    "check:required-files": "node scripts/check-required-release-files.js",
    "check:release-artifacts": "node scripts/check-release-artifacts.js",
    "check:frontend-privacy": "node scripts/check-frontend-privacy.js",
    "check:public-path-leaks": "node scripts/check-public-path-leaks.js",
    "check:release": "npm run check:required-files && npm run check:release-artifacts && npm run check:frontend-privacy && npm run check:public-path-leaks && node --check server.js && npm test",
    "check": "npm run check:release",
    "prepack": "npm run check:required-files && npm run check:release-artifacts && npm run check:frontend-privacy && npm run check:public-path-leaks",
    "qa:voice-redo": "node scripts/qa-penny-voice-redo.js",
    "qa:voice-writing-compare": "node scripts/qa-penny-voice-writing-compare.js",
    "qa:voice:tiebreak": "node scripts/qa-penny-voice-redo.js --prompt-set tiebreak",
    "qa:voice:constellation": "node scripts/qa-penny-voice-redo.js --prompt-set constellation",
    "qa:memory:smoke": "node scripts/qa-penny-memory.js --smoke",
    "qa:memory": "node scripts/qa-penny-memory.js",
    "qa:memory:combined": "node scripts/qa-penny-memory.js --combined",
    "qa:memory:judged": "node scripts/qa-penny-memory.js --judged",
    "qa:memory:source-sensitive": "node scripts/qa-penny-memory.js --source-sensitive-fixture",
    "qa:memory:candidate-survival": "node scripts/qa-penny-memory.js --candidate-survival-archive-unit",
    "qa:memory:candidate-survival-fixture": "node scripts/qa-penny-memory.js --candidate-survival-fixture",
    "qa:memory:links": "node scripts/qa-penny-memory-links.js --fixture",
    "qa:semantic:source-audit": "node scripts/qa-penny-semantic-source-audit.js --fixture",
    "qa:session-reflection": "node scripts/qa-penny-session-reflection.js --fixture",
    "export:semantic-claims": "node scripts/export-penny-semantic-claims.js",
    "qa:memory:semantic": "node scripts/qa-penny-memory.js --segment semantic-archive",
    "qa:memory:chapter": "node scripts/qa-penny-memory.js --segment chapter-fallback",
    "qa:memory:contradictions": "node scripts/qa-penny-memory.js --segment contradiction-premise",
    "qa:memory:mixed": "node scripts/qa-penny-memory.js --segment mixed-drift",
    "qa:browser:install": "node scripts/qa-penny-browser-smoke.js --install-browser",
    "qa:browser:smoke": "node scripts/qa-penny-browser-smoke.js",
    "qa:next-cycle": "node scripts/qa-penny-next-cycle.js",
    "eval:probes": "node scripts/eval-penny-probes.js",
    "eval:epistemic-compare": "node scripts/eval-penny-epistemic-compare.js",
    "eval:epistemic-compare:synthesis": "node scripts/eval-penny-epistemic-compare.js --primary-modes off,synthesis-only --diagnostics never",
    "eval:ledger-compare": "node scripts/eval-penny-ledger-compare.js",
    "eval:open-loop-compare": "node scripts/eval-penny-open-loop-compare.js",
    "eval:session-reflection-compare": "node scripts/eval-penny-session-reflection-compare.js",
    "eval:memory-links": "node scripts/eval-penny-memory-links-compare.js",
    "eval:aliveness:fixture": "node scripts/eval-penny-aliveness-compare.js --fixture",
    "eval:frame-budget": "node scripts/eval-penny-frame-budget.js",
    "eval:static-embedding-live-compare": "node scripts/eval-penny-static-embedding-live-compare.js",
    "eval:runtime-fit": "node scripts/eval-penny-runtime-fit.js",
    "eval:runtime-fit:context-pressure": "node scripts/eval-penny-runtime-fit.js --context-pressure-fixture",
    "eval:runtime-fit:gemma-watch": "node scripts/eval-penny-runtime-fit.js --gemma-runtime-watch",
    "eval:models": "node scripts/eval-penny-models.js",
    "penny:apps": "node scripts/penny-local-llm-apps.js",
    "penny:apps:license-review": "node scripts/penny-local-llm-apps.js --needs-license-review",
    "penny:sidecars": "node scripts/penny-sidecar-trial.js",
    "penny:endpoint:probe": "node scripts/penny-local-endpoint-compatibility.js",
    "penny:endpoint:probe:model-call": "node scripts/penny-local-endpoint-compatibility.js --probe-model-call",
    "penny:model-watch": "node scripts/penny-model-runtime-watch.js",
    "penny:model-compare": "node scripts/penny-model-profile-compare.js",
    "penny:pi:check": "node scripts/penny-operator-sidecar.js --app Pi",
    "penny:pi:template": "node scripts/penny-operator-sidecar.js --app Pi --template",
    "penny:pi:models-json": "node scripts/penny-operator-sidecar.js --app Pi --models-json",
    "penny:pi:validate-template": "node scripts/penny-operator-sidecar.js --app Pi --validate-template",
    "penny:pi:copy-plan": "node scripts/penny-operator-sidecar.js --app Pi --copy-plan",
    "penny:pi:trial": "node scripts/penny-operator-sidecar.js --app Pi --trial",
    "penny:pi:trial-fixture": "node scripts/penny-operator-sidecar.js --app Pi --trial --prepare-disposable-repo",
    "penny:opencode:check": "node scripts/penny-operator-sidecar.js --app OpenCode",
    "penny:opencode:template": "node scripts/penny-operator-sidecar.js --app OpenCode --template",
    "penny:opencode:trial": "node scripts/penny-operator-sidecar.js --app OpenCode --trial",
    "penny:patterns": "node scripts/penny-sidecar-patterns.js",
    "penny:lab-cockpit": "node scripts/penny-lab-cockpit.js",
    "penny:workflow-sidecar": "node scripts/penny-workflow-sidecar.js",
    "penny:sidecar:lab-cockpit": "node scripts/penny-lab-cockpit-trial.js",
    "penny:sidecar:home-camera": "node scripts/penny-home-camera-event-trial.js",
    "penny:sidecar:workflow": "node scripts/penny-workflow-sidecar-trial.js",
    "penny:sidecar:research": "node scripts/penny-research-sidecar-trial.js",
    "penny:sidecar:rag": "node scripts/penny-rag-workspace-trial.js",
    "penny:sidecar:audio": "node scripts/penny-audio-voice-sidecar-trial.js",
    "penny:sidecar:completion-gate": "node scripts/penny-sidecar-section-completion-gate.js",
    "penny:sidecar:descriptors": "node scripts/penny-sidecar-descriptors.js",
    "penny:sidecar:test-fixtures": "node scripts/penny-sidecar-test-fixtures.js",
    "ingest:conversations": "node scripts/import-penny-conversations.js",
    "preset:lmstudio": "node scripts/ensure-lmstudio-penny-preset.js",
    "bundle:review": "node scripts/build-review-bundle.js",
    "bundle:review:experience": "node scripts/build-review-bundle.js --experience"
  },
  "optionalDependencies": {
    "@yarflam/potion-base-8m": "1.0.4"
  }
}
