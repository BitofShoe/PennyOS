# PennyOS local runtime settings
# Copy this file to .env, then adjust model names for your local LM Studio or llama.cpp server.

PORT=4317
HOST=127.0.0.1

# OpenAI-compatible local model endpoint.
# LM Studio default:
PENNY_LMSTUDIO_BASE=http://127.0.0.1:1234/v1
PENNY_LMSTUDIO_NATIVE_BASE=http://127.0.0.1:1234/api/v1
# If this endpoint is llama.cpp/vLLM/etc., doctor usually detects it from /models.
# Set this explicitly when you want doctor to skip LM Studio CLI/preset checks.
PENNY_LOCAL_LLM_BACKEND=lm_studio
# Optional: point semantic memory embeddings at a separate OpenAI-compatible endpoint.
# Defaults to PENNY_LMSTUDIO_BASE when blank.
PENNY_LMSTUDIO_EMBED_BASE=

# Optional OpenAI Platform cloud mode.
# Prefer Settings -> Brain connection -> Connect OpenAI cloud in the app.
# This is not local/private: prompts, memory context, and tool context can leave
# your computer, and OpenAI API usage may cost money. A ChatGPT subscription is
# not the same thing as an API key.
# PENNY_MODEL_PROVIDER=openai_cloud
# PENNY_LOCAL_LLM_BACKEND=openai_compatible
# PENNY_LOCAL_RUNTIME_LABEL=OpenAI API (cloud)
# PENNY_LMSTUDIO_BASE=https://api.openai.com/v1
# PENNY_LMSTUDIO_EMBED_BASE=https://api.openai.com/v1
# PENNY_LOCAL_LLM_TRANSPORT=chat
# PENNY_LMSTUDIO_CHAT_MODEL=gpt-5.5
# PENNY_LMSTUDIO_TOOL_MODEL=gpt-5.5
# PENNY_LMSTUDIO_EMBED_MODEL=text-embedding-3-small
# PENNY_LMSTUDIO_API_KEY=sk-your-openai-platform-api-key

# Transport: generated .env files choose chat as the most portable LM Studio/llama.cpp path.
# If this line is absent, the raw server default is auto, which tries native stateful first,
# then chat/completions, then /responses. Keep chat unless you are testing transport behavior.
PENNY_LOCAL_LLM_TRANSPORT=chat

# Replace these with model IDs available in your local server.
PENNY_LMSTUDIO_CHAT_MODEL=google/gemma-4-31b
PENNY_LMSTUDIO_TOOL_MODEL=google/gemma-4-e4b
PENNY_LMSTUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# Optional: force exact configured/picked models instead of falling back to another compatible loaded model.
PENNY_LMSTUDIO_DISABLE_MODEL_FALLBACK=0

# Local sharing and API protection.
PENNY_LAN_SHARE=0
PENNY_API_TOKEN=
PENNY_REQUIRE_API_TOKEN=0
PENNY_API_ALLOW_LOCAL_NO_TOKEN=0

# Web reading/search. Recommended release default: off unless you opt in.
PENNY_WEB_SEARCH_ENABLED=0
# model = Penny uses search results through the model tool loop; direct = fixed fast result list.
PENNY_WEB_ANSWER_MODE=model
PENNY_WEB_ALLOW_PRIVATE_NET=0

# Workspace tools.
PENNY_ENABLE_DIRECT_WORKSPACE_WRITES=0

# Debug/reasoning safety.
PENNY_ALLOW_RAW_REASONING_FALLBACK=0
PENNY_LOG_LMSTUDIO_REASONING=0

# Background chat vectorization runs after replies and defaults on. It can consume local
# embedding/backend/cache capacity; set to 0 if your machine needs the breathing room.
PENNY_ENABLE_BACKGROUND_CHAT_VECTORS=1

# Local companion profile defaults. Generated .env files keep these on so Penny feels
# alive by default; deleting the lines returns to the raw server default of off.
PENNY_ENABLE_OPEN_LOOP_PROMPT=1
PENNY_OPEN_LOOP_MAX_RENDERED=1
PENNY_ENABLE_BOUNDED_INITIATIVE=1
PENNY_INITIATIVE_MAX_PER_TURN=1
PENNY_INITIATIVE_COOLDOWN_TURNS=3
PENNY_ENABLE_TURN_STATE_PROMPT=1
PENNY_TURN_STATE_MAX_TOKENS=120

# Optional local static embedding provider. Leave off unless you know you need it.
PENNY_STATIC_EMBED_MODE=off
PENNY_STATIC_EMBED_PROVIDER=model2vec-potion-8m
