{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PennyOS",
  "version": "0.1.4",
  "identifier": "com.bitofshoe.pennyos",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PennyOS",
        "url": "index.html",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "gen/penny-runtime/": "penny-runtime/"
    },
    "externalBin": [
      "binaries/penny-node"
    ]
  }
}
